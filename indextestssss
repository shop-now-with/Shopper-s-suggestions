  ["🏠","Home"],
  ["👕","Fashion"],
  ["✨","Beauty"],
  ["🎮","Gaming"],
  ["⚽","Sports"],
  ["✈️","Travel"],
  ["🍳","Kitchen"],
  ["📚","Office"],
  ["🚗","Automotive"],
  ["📱","Electronics"],
  ["🧸","Kids"],
  ["🐾","Pets"],
  ["🏃","Fitness"],
  ["📖","Books"],
  ["🎒","Accessories"],
  ["📷","Photography"],
  ["🎥","Creator"],
  ["📦","Other"]

];


function buildCategories(){

  const grid =
    document.getElementById(
      "categoryGrid"
    );


  grid.innerHTML =
