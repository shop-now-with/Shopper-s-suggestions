}


/* =========================================================
   CATEGORY SEARCH
========================================================= */

function categorySearch(){

  const input =
    document.getElementById(
      "categorySearch"
    );


  const query =
    input.value
      .trim()
      .toLowerCase();


  if(!query){

    document
      .getElementById(
        "categoryResults"
      )
      .classList.add("hidden");

    return;

  }


  const results =
    allProducts.filter(
      product => {

        const title =
          String(
            product.title || ""
          ).toLowerCase();


        const description =
          String(
            product.description || ""
          ).toLowerCase();


        const category =
          String(
            product.category || ""
          ).toLowerCase();


        return (
          title.includes(query) ||
          description.includes(query) ||
          category.includes(query)
        );

      }
    );


  showCategoryResults(
    "Search results",
    results
  );

}


/* =========================================================
   OPEN CATEGORY
========================================================= */

function openCategory(category){

  currentCategory =
    category;


  const results =
    allProducts.filter(
      product =>
        String(
          product.category || ""
        ).toLowerCase()
        ===
        category.toLowerCase()
    );


  showCategoryResults(
    category,
    results
  );

}


function showCategoryResults(
  title,
  products
){

  const section =
    document.getElementById(
      "categoryResults"
    );


  section.classList.remove(
    "hidden"
  );


  document.getElementById(
    "categoryResultTitle"
  ).textContent =
