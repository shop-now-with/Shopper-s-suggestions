<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#ffffff">

<title>Shopper's Suggestions</title>

<style>

/* =========================================================
   RESET
========================================================= */

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background:#fff;
  color:#0b1730;

  overflow-x:hidden;
}


/* =========================================================
   BACKGROUND
========================================================= */

.background{
  position:fixed;
  inset:0;
  overflow:hidden;
  pointer-events:none;
  z-index:-20;
  background:#fff;
}

.orb{
  position:absolute;
  border-radius:50%;
  filter:blur(75px);
  pointer-events:none;
}

.orb.one{
  width:430px;
  height:430px;
  left:-180px;
  top:8%;
  background:#ff6f12;
  opacity:.25;

  animation:
    orbOne 15s ease-in-out infinite alternate;
}

.orb.two{
  width:520px;
  height:520px;
  right:-230px;
  top:38%;
  background:#155b9e;
  opacity:.23;

  animation:
    orbTwo 18s ease-in-out infinite alternate;
}

.orb.three{
  width:320px;
  height:320px;
  left:35%;
  bottom:-180px;
  background:#ff9c57;
  opacity:.15;

  animation:
    orbThree 13s ease-in-out infinite alternate;
}

@keyframes orbOne{

  0%{
    transform:
      translate(0,0)
      scale(.8);
  }

  50%{
    transform:
      translate(180px,100px)
      scale(1.2);
  }

  100%{
    transform:
      translate(50px,300px)
      scale(.9);
  }

}

@keyframes orbTwo{

  0%{
    transform:
      translate(0,0)
      scale(1);
  }

  50%{
    transform:
      translate(-160px,-120px)
      scale(.78);
  }

  100%{
    transform:
      translate(-50px,190px)
      scale(1.18);
  }

}

@keyframes orbThree{

  0%{
    transform:
      translate(0,0)
      scale(.8);
  }

  100%{
    transform:
      translate(130px,-130px)
      scale(1.2);
  }

}


/* =========================================================
   MOVING LIGHT LINES
========================================================= */

.light-lines{
  position:absolute;
  inset:0;
  overflow:hidden;
}

.light-lines span{
  position:absolute;

  width:48vw;
  height:1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,106,0,.45),
      rgba(14,57,99,.35),
      transparent
    );

  animation:
    lineMove 11s linear infinite;
}

.light-lines span:nth-child(1){
  top:9%;
  left:-50%;
}

.light-lines span:nth-child(2){
  top:24%;
  left:-60%;
  animation-delay:2s;
}

.light-lines span:nth-child(3){
  top:42%;
  left:-40%;
  animation-delay:4s;
}

.light-lines span:nth-child(4){
  top:64%;
  left:-55%;
  animation-delay:6s;
}

.light-lines span:nth-child(5){
  top:81%;
  left:-45%;
  animation-delay:8s;
}

@keyframes lineMove{

  from{
    transform:
      translateX(0)
      rotate(-5deg);
  }

  to{
    transform:
      translateX(250vw)
      rotate(-5deg);
  }

}


/* =========================================================
   FLOATING PARTICLES
========================================================= */

.particles{
  position:absolute;
  inset:0;
}

.particle{
  position:absolute;

  width:4px;
  height:4px;

  border-radius:50%;

  background:#ff7015;

  box-shadow:
    0 0 14px rgba(255,112,21,.8);

  animation:
    particleFloat 9s ease-in-out infinite;
}

.particle:nth-child(1){
  left:6%;
  top:18%;
}

.particle:nth-child(2){
  left:14%;
  top:67%;
  animation-delay:-2s;
}

.particle:nth-child(3){
  left:28%;
  top:35%;
  animation-delay:-4s;
}

.particle:nth-child(4){
  left:43%;
  top:77%;
  animation-delay:-6s;
}

.particle:nth-child(5){
  left:58%;
  top:23%;
  animation-delay:-3s;
}

.particle:nth-child(6){
  left:72%;
  top:56%;
  animation-delay:-5s;
}

.particle:nth-child(7){
  left:84%;
  top:17%;
  animation-delay:-7s;
}

.particle:nth-child(8){
  left:94%;
  top:81%;
  animation-delay:-1s;
}

.particle:nth-child(9){
  left:51%;
  top:45%;
  animation-delay:-8s;
}

@keyframes particleFloat{

  0%,100%{
    transform:
      translate(0,0)
      scale(.6);

    opacity:.15;
  }

  50%{
    transform:
      translate(35px,-60px)
      scale(1.6);

    opacity:.85;
  }

}


/* =========================================================
   HEADER
========================================================= */

header{
  position:sticky;
  top:0;
  z-index:1000;

  background:
    rgba(255,255,255,.82);

  backdrop-filter:
    blur(25px);

  border-bottom:
    1px solid rgba(15,40,75,.08);

  animation:
    headerAppear .8s ease both;
}

@keyframes headerAppear{

  from{
    opacity:0;
    transform:translateY(-25px);
  }

  to{
    opacity:1;
    transform:none;
  }

}

.nav{
  max-width:1320px;
  margin:auto;

  min-height:76px;

  padding:
    8px 4%;

  display:flex;

  align-items:center;

  justify-content:space-between;
}


/* =========================================================
   BRAND
========================================================= */

.brand{
  display:flex;

  align-items:center;

  gap:12px;

  text-decoration:none;

  min-width:0;
}

.logo{
  width:105px;
  height:55px;

  object-fit:contain;

  flex-shrink:0;

  animation:
    logoFloat 5s ease-in-out infinite;
}

@keyframes logoFloat{

  0%,100%{
    transform:
      translateY(0)
      scale(1);
  }

  50%{
    transform:
      translateY(-2px)
      scale(1.035);
  }

}

.brand-name{
  font-size:clamp(17px,2.1vw,25px);

  line-height:1;

  font-weight:900;

  letter-spacing:-.8px;

  white-space:nowrap;

  background:
    linear-gradient(
      100deg,
      #ff6900,
      #ff832e 34%,
      #0b2e59 67%,
      #165f9e
    );

  -webkit-background-clip:text;

  background-clip:text;

  color:transparent;

  background-size:230% auto;

  animation:
    brandGradient 7s linear infinite;
}

@keyframes brandGradient{

  to{
    background-position:230% center;
  }

}


/* =========================================================
   MENU BUTTON
========================================================= */

.menu-button{
  width:48px;
  height:48px;

  border:none;

  border-radius:15px;

  background:
    rgba(255,255,255,.8);

  box-shadow:
    0 8px 25px rgba(15,40,75,.08);

  display:flex;

  align-items:center;
  justify-content:center;

  cursor:pointer;

  transition:.35s;
}

.menu-button:hover{
  transform:
    translateY(-2px)
    rotate(2deg);

  box-shadow:
    0 14px 35px rgba(15,40,75,.13);
}

.menu-icon{
  width:21px;
  height:16px;

  display:flex;

  flex-direction:column;

  justify-content:space-between;
}

.menu-icon span{
  width:100%;
  height:2px;

  border-radius:20px;

  background:#0b1730;

  transition:.35s;
}

.menu-button.open .menu-icon span:nth-child(1){
  transform:
    translateY(7px)
    rotate(45deg);
}

.menu-button.open .menu-icon span:nth-child(2){
  opacity:0;
}

.menu-button.open .menu-icon span:nth-child(3){
  transform:
    translateY(-7px)
    rotate(-45deg);
}


/* =========================================================
   SIDE MENU
========================================================= */

.menu-overlay{
  position:fixed;

  inset:0;

  z-index:900;

  background:
    rgba(5,17,31,.18);

  backdrop-filter:
    blur(5px);

  opacity:0;

  pointer-events:none;

  transition:.35s;
}

.menu-overlay.show{
  opacity:1;

  pointer-events:auto;
}

.side-menu{
  position:fixed;

  z-index:950;

  top:0;
  right:0;

  width:min(390px,88vw);

  height:100vh;

  padding:
    105px 28px 30px;

  background:
    rgba(255,255,255,.94);

  backdrop-filter:
    blur(30px);

  border-left:
    1px solid rgba(15,40,75,.08);

  box-shadow:
    -20px 0 70px rgba(15,40,75,.13);

  transform:
    translateX(105%);

  transition:
    transform .55s cubic-bezier(.2,.8,.2,1);
}

.side-menu.show{
  transform:translateX(0);
}

.menu-title{
  margin-bottom:28px;
}

.menu-title small{
  display:block;

  color:#ff6c0a;

  font-size:11px;

  font-weight:900;

  text-transform:uppercase;

  letter-spacing:2px;

  margin-bottom:7px;
}

.menu-title h2{
  font-size:29px;

  letter-spacing:-1.2px;
}

.menu-links{
  display:flex;

  flex-direction:column;

  gap:8px;
}

.menu-link{
  border:none;

  background:transparent;

  text-align:left;

  padding:
    17px 16px;

  border-radius:15px;

  font-size:16px;

  font-weight:750;

  color:#0b1730;

  cursor:pointer;

  display:flex;

  align-items:center;

  justify-content:space-between;

  transition:.3s;
}

.menu-link span:last-child{
  color:#8c96a5;

  font-size:20px;

  transition:.3s;
}

.menu-link:hover{
  background:
    linear-gradient(
      100deg,
      rgba(255,106,0,.09),
      rgba(16,65,110,.06)
    );

  transform:
    translateX(5px);
}

.menu-link:hover span:last-child{
  transform:
    translateX(4px);

  color:#ff6c0a;
}


/* =========================================================
   PAGE SYSTEM
========================================================= */

.page{
  display:none;

  min-height:
    calc(100vh - 76px);

  animation:
    pageEnter .65s cubic-bezier(.2,.8,.2,1);
}

.page.active{
  display:block;
}

@keyframes pageEnter{

  from{
    opacity:0;
    transform:
      translateY(18px)
      scale(.99);
  }

  to{
    opacity:1;
    transform:none;
  }

}


/* =========================================================
   HOME
========================================================= */

.home{
  max-width:1300px;

  margin:auto;

  padding:
    85px 5%
    120px;

  text-align:center;
}

.home-badge{
  display:inline-flex;

  align-items:center;

  gap:8px;

  padding:
    9px 14px;

  border-radius:99px;

  background:
    rgba(255,255,255,.75);

  border:
    1px solid rgba(15,40,75,.08);

  box-shadow:
    0 10px 30px rgba(15,40,75,.05);

  color:#667085;

  font-size:11px;

  font-weight:850;

  letter-spacing:1.1px;

  text-transform:uppercase;

  animation:
    fadeUp 1s both;
}

.badge-dot{
  width:7px;
  height:7px;

  border-radius:50%;

  background:#ff6c0a;

  box-shadow:
    0 0 13px rgba(255,108,10,.7);

  animation:
    pulseDot 2s ease-in-out infinite;
}

@keyframes pulseDot{

  0%,100%{
    transform:scale(.8);
    opacity:.55;
  }

  50%{
    transform:scale(1.4);
    opacity:1;
  }

}

.home h1{
  max-width:950px;

  margin:
    25px auto 0;

  font-size:
    clamp(43px,8vw,88px);

  line-height:.94;

  letter-spacing:-4px;

  font-weight:950;

  background:
    linear-gradient(
      105deg,
      #ff6500,
      #ff8a32 27%,
      #0a2c55 62%,
      #1765a8
    );

  background-size:250% auto;

  -webkit-background-clip:text;

  background-clip:text;

  color:transparent;

  animation:
    heroGradient 7s linear infinite,
    heroAppear 1s cubic-bezier(.2,.8,.2,1) both;
}

@keyframes heroGradient{

  to{
    background-position:250% center;
  }

}

@keyframes heroAppear{

  from{
    opacity:0;

    transform:
      translateY(35px)
      scale(.94);
  }

  to{
    opacity:1;

    transform:none;
  }

}

.home-description{
  max-width:650px;

  margin:
    25px auto 0;

  color:#667085;

  font-size:16px;

  line-height:1.75;

  animation:
    fadeUp 1s .15s both;
}


/* =========================================================
   BIG SEARCH
========================================================= */

.big-search{
  max-width:850px;

  margin:
    45px auto 0;

  position:relative;

  animation:
    searchAppear 1s .25s both;
}

@keyframes searchAppear{

  from{
    opacity:0;

    transform:
      translateY(25px)
      scale(.96);
  }

  to{
    opacity:1;

    transform:none;
  }

}

.big-search-box{
  position:relative;

  height:78px;

  display:flex;

  align-items:center;

  padding:
    8px;

  border-radius:23px;

  background:
    rgba(255,255,255,.85);

  border:
    1px solid rgba(15,40,75,.1);

  box-shadow:
    0 20px 65px rgba(15,40,75,.1);

  backdrop-filter:
    blur(20px);

  transition:.35s;
}

.big-search-box:focus-within{
  transform:
    translateY(-3px);

  border-color:
    rgba(255,108,10,.4);

  box-shadow:
    0 25px 75px rgba(15,40,75,.14),
    0 0 0 5px rgba(255,108,10,.06);
}

.search-icon{
  width:55px;

  font-size:23px;

  color:#738096;

  flex-shrink:0;
}

.big-search input{
  width:100%;

  height:100%;

  border:none;

  outline:none;

  background:transparent;

  color:#0b1730;

  font-size:18px;

  padding:
    0 10px;
}

.big-search input::placeholder{
  color:#99a2b0;
}

.search-button{
  height:60px;

  padding:
    0 25px;

  border:none;

  border-radius:17px;

  color:#fff;

  font-size:14px;

  font-weight:900;

  cursor:pointer;

  background:
    linear-gradient(
      105deg,
      #ff6500,
      #ff8328,
      #0b315e
    );

  background-size:220% auto;

  animation:
    searchButtonFlow 5s linear infinite;

  transition:.3s;

  white-space:nowrap;
}

@keyframes searchButtonFlow{

  to{
    background-position:220% center;
  }

}

.search-button:hover{
  transform:
    scale(1.025);
}


/* =========================================================
   SEARCH RESULTS
========================================================= */

.results-area{
  max-width:1300px;

  margin:auto;

  padding:
    0 5%
    100px;
}

.results-head{
  display:flex;

  justify-content:space-between;

  align-items:end;

  margin-bottom:25px;
}

.results-head h2{
  font-size:29px;

  letter-spacing:-1px;
}

.results-head span{
  color:#667085;

  font-size:13px;
}

.product-grid{
  display:grid;

  grid-template-columns:
    repeat(
      auto-fill,
      minmax(285px,1fr)
    );

  gap:27px;
}

.hidden-results{
  display:none;
}


/* =========================================================
   PRODUCT CARD
========================================================= */

.product-card{
  position:relative;

  overflow:hidden;

  border-radius:25px;

  background:
    rgba(255,255,255,.91);

  border:
    1px solid rgba(15,40,75,.09);

  box-shadow:
    0 15px 55px rgba(15,40,75,.08);

  transition:
    transform .45s cubic-bezier(.2,.8,.2,1),
    box-shadow .45s;

  animation:
    cardAppear .7s both;
}

.product-card:before{
  content:"";

  position:absolute;

  inset:-2px;

  z-index:5;

  pointer-events:none;

  border-radius:27px;

  padding:1px;

  background:
    linear-gradient(
      110deg,
      transparent,
      rgba(255,106,0,.45),
      transparent,
      rgba(20,82,145,.42),
      transparent
    );

  background-size:
    300% 300%;

  animation:
    borderFlow 6s linear infinite;

  mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);

  mask-composite:
    exclude;
}

.product-card:hover{
  transform:
    translateY(-9px);

  box-shadow:
    0 30px 75px rgba(15,40,75,.14);
}

@keyframes cardAppear{

  from{
    opacity:0;

    transform:
      translateY(30px)
      scale(.97);
  }

  to{
    opacity:1;

    transform:none;
  }

}

@keyframes borderFlow{

  to{
    background-position:
      300% 0;
  }

}


/* =========================================================
   GALLERY
========================================================= */

.gallery{
  position:relative;

  aspect-ratio:1/1;

  overflow:hidden;

  background:
    linear-gradient(
      135deg,
      #f4f7fa,
      #fff
    );

  touch-action:pan-y;
}

.gallery-track{
  height:100%;

  display:flex;

  transition:
    transform .5s cubic-bezier(.2,.8,.2,1);
}

.gallery-slide{
  min-width:100%;

  height:100%;

  display:flex;

  align-items:center;

  justify-content:center;
}

.gallery-slide img{
  width:100%;
  height:100%;

  object-fit:contain;

  transition:
    transform .7s;
}

.product-card:hover
.gallery-slide img{
  transform:
    scale(1.035);
}


/* IMAGE SHINE */

.gallery:after{
  content:"";

  position:absolute;

  inset:0;

  pointer-events:none;

  background:
    linear-gradient(
      115deg,
      transparent 20%,
      rgba(255,255,255,.72) 46%,
      transparent 67%
    );

  transform:
    translateX(-120%);

  animation:
    imageShine 7s ease-in-out infinite;
}

@keyframes imageShine{

  0%,55%{
    transform:
      translateX(-120%);
  }

  76%,100%{
    transform:
      translateX(120%);
  }

}


/* GALLERY BUTTONS */

.gallery-arrow{
  position:absolute;

  z-index:8;

  top:50%;

  transform:
    translateY(-50%);

  width:40px;
  height:40px;

  border:none;

  border-radius:50%;

  background:
    rgba(255,255,255,.9);

  box-shadow:
    0 8px 25px rgba(0,0,0,.12);

  color:#0b1730;

  font-size:25px;

  cursor:pointer;

  transition:.3s;
}

.gallery-arrow:hover{
  transform:
    translateY(-50%)
    scale(1.13);
}

.gallery-left{
  left:12px;
}

.gallery-right{
  right:12px;
}

.gallery-dots{
  position:absolute;

  z-index:8;

  bottom:13px;

  left:50%;

  transform:
    translateX(-50%);

  display:flex;

  gap:6px;

  padding:
    6px 9px;

  border-radius:99px;

  background:
    rgba(255,255,255,.75);

  backdrop-filter:
    blur(8px);
}

.gallery-dot{
  width:6px;
  height:6px;

  border-radius:50%;

  background:#aeb6c2;

  transition:.3s;
}

.gallery-dot.active{
  background:#0b315d;

  transform:
    scale(1.4);
}

.gallery-counter{
  position:absolute;

  z-index:8;

  top:12px;
  right:12px;

  color:#fff;

  background:
    rgba(11,23,48,.75);

  border-radius:99px;

  padding:
    6px 9px;

  font-size:11px;
}


/* =========================================================
   PRODUCT CONTENT
========================================================= */

.product-content{
  padding:21px;
}

.category-tag{
  display:inline-block;

  padding:
    7px 10px;

  margin-bottom:10px;

  border-radius:99px;

  background:#fff0e5;

  color:#e96810;

  font-size:10px;

  font-weight:900;

  text-transform:uppercase;

  letter-spacing:.8px;
}

.product-title{
  font-size:21px;

  line-height:1.25;

  color:#0b1730;

  margin-bottom:12px;
}

.product-description{
  color:#667085;

  font-size:14.5px;

  line-height:1.75;

  white-space:pre-wrap;

  word-break:break-word;

  margin-bottom:17px;
}

.product-video{
  margin-top:15px;

  overflow:hidden;

  border-radius:15px;

  background:#000;
}

.product-video video{
  width:100%;

  display:block;
}

.buy-button{
  position:relative;

  overflow:hidden;

  display:block;

  width:100%;

  padding:
    15px 18px;

  border-radius:14px;

  text-align:center;

  text-decoration:none;

  color:#fff;

  font-size:13px;

  font-weight:900;

  letter-spacing:.4px;

  background:
    linear-gradient(
      105deg,
      #ff6500,
      #ff8126 35%,
      #0b315d 72%,
      #165f9f
    );

  background-size:
    220% 100%;

  animation:
    buyFlow 5s linear infinite;

  box-shadow:
    0 10px 28px rgba(15,49,88,.16);

  transition:.3s;
}

.buy-button:hover{
  transform:
    translateY(-2px);
}

.buy-button:after{
  content:"";

  position:absolute;

  inset:0;

  background:
    linear-gradient(
      100deg,
      transparent,
      rgba(255,255,255,.4),
      transparent
    );

  transform:
    translateX(-120%);

  animation:
    buttonShine 4s infinite;
}

@keyframes buyFlow{

  to{
    background-position:
      220% 0;
  }

}

@keyframes buttonShine{

  0%,55%{
    transform:
      translateX(-120%);
  }

  75%,100%{
    transform:
      translateX(120%);
  }

}


/* =========================================================
