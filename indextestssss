/* =========================================================
   RENDER PRODUCTS
========================================================= */

function renderProducts(
  products,
  containerId
){

  const container =
    document.getElementById(
      containerId
    );


  if(!container){

    return;

  }


  if(!products.length){

    container.innerHTML = `

      <div class="no-results">

        No matching products found.

        <br><br>

        Try another search.

      </div>

    `;

    return;

  }


  container.innerHTML =
    products.map(
      (product,index) =>
        createProductCard(
          product,
          index
        )
    ).join("");


  setupSwipe();

}


/* =========================================================
   PRODUCT CARD
========================================================= */

function createProductCard(
  product,
  index
){

  let images = [

    product.image1_url,
    product.image2_url,
    product.image3_url,
    product.image4_url,
    product.image5_url

  ].filter(
    image =>
      typeof image === "string" &&
      image.trim()
  );


  /*
    ALSO SUPPORT
    product.images[]
  */

  if(
    Array.isArray(
      product.images
    )
  ){

    product.images.forEach(
      image => {

        if(
          image &&
          !images.includes(image)
        ){

          images.push(image);

        }

      }
    );

  }


  if(!images.length){

    images = [

      "https://via.placeholder.com/800x800?text=No+Image"

    ];

  }


  const galleryId =
    "gallery-" +
    product.id +
    "-" +
    Math.random()
      .toString(36)
      .slice(2,8);


  const slides =
    images.map(
      image => `

        <div class="gallery-slide">

          <img
            src="${escapeHTML(image)}"
            alt="${escapeHTML(
              product.title ||
              "Product"
            )}"
            loading="lazy"
          >

        </div>

      `
    ).join("");


  const dots =
    images.map(
      (_,i) => `

        <span
          class="
            gallery-dot
            ${i === 0 ? "active" : ""}
          "
        ></span>

      `
    ).join("");


  const video =
    product.video_url

      ?

      `

        <div class="product-video">

          <video
            controls
            preload="metadata"
            src="${escapeHTML(
              product.video_url
            )}"
          ></video>

        </div>

      `

      :

      "";


  return `

    <article
      class="product-card"
      style="
        animation-delay:
        ${Math.min(
          index * 65,
          600
        )}ms
      "
    >


      <div
        class="gallery"
        id="${galleryId}"
        data-index="0"
        data-count="${images.length}"
      >

        <div class="gallery-track">

          ${slides}

        </div>


        ${
          images.length > 1

          ?

          `

            <button
              class="
                gallery-arrow
                gallery-left
              "
              onclick="
                changeSlide(
                  '${galleryId}',
                  -1
                )
              "
              aria-label="Previous image"
            >
              ‹
            </button>


            <button
              class="
                gallery-arrow
                gallery-right
              "
              onclick="
                changeSlide(
                  '${galleryId}',
                  1
                )
              "
              aria-label="Next image"
            >
              ›
            </button>


            <div class="gallery-dots">

              ${dots}

            </div>


            <div class="gallery-counter">

              <span class="gallery-current">
                1
              </span>

              /
              ${images.length}

            </div>

          `

          :

          ""

        }

      </div>


      <div class="product-content">


        ${
          product.category

            ?

            `

              <div class="category-tag">

                ${escapeHTML(
                  product.category
                )}

              </div>

            `

            :

            ""

        }


        <h2 class="product-title">

          ${escapeHTML(
            product.title || ""
          )}

        </h2>


        <div class="product-description">

          ${escapeHTML(
            product.description || ""
          )}

        </div>


        ${video}


        ${
          product.affiliate_url

            ?

            `

              <a
                class="buy-button"
                href="${escapeHTML(
                  product.affiliate_url
                )}"
                target="_blank"
                rel="
                  noopener
                  noreferrer
                  sponsored
                "
              >

                MAKE IT YOURS!

              </a>

            `

            :

            ""

        }

      </div>

    </article>

  `;

}


/* =========================================================
   IMAGE SLIDER
========================================================= */

function changeSlide(
  id,
  direction
){

  const gallery =
    document.getElementById(id);


  if(!gallery){

    return;

  }


  const track =
    gallery.querySelector(
      ".gallery-track"
    );


  const dots =
    gallery.querySelectorAll(
      ".gallery-dot"
    );


  const current =
    gallery.querySelector(
      ".gallery-current"
    );


  const count =
    Number(
      gallery.dataset.count
    );


  let index =
    Number(
      gallery.dataset.index
    ) +
    direction;


  if(index < 0){

    index =
      count - 1;

  }


  if(index >= count){

    index = 0;

  }


  gallery.dataset.index =
    index;


  track.style.transform =
    `translateX(-${index * 100}%)`;


  dots.forEach(
    (dot,i) => {

      dot.classList.toggle(
        "active",
        i === index
      );

    }
  );


  if(current){

    current.textContent =
      index + 1;

  }

}


/* =========================================================
   SWIPE
========================================================= */

function setupSwipe(){

  document
    .querySelectorAll(
      ".gallery"
    )
    .forEach(
      gallery => {

        let startX = 0;
        let startY = 0;


        gallery.addEventListener(
          "touchstart",
          event => {

            startX =
              event.touches[0]
                .clientX;

            startY =
              event.touches[0]
                .clientY;

          },
          {
            passive:true
          }
        );


        gallery.addEventListener(
          "touchend",
          event => {

            const dx =
              event.changedTouches[0]
                .clientX -
              startX;


            const dy =
              event.changedTouches[0]
                .clientY -
              startY;


            if(
              Math.abs(dx) > 45 &&
              Math.abs(dx) >
                Math.abs(dy)
            ){

              changeSlide(
                gallery.id,
                dx < 0 ? 1 : -1
              );

            }

          },
          {
            passive:true
          }
        );

      }
    );

}


