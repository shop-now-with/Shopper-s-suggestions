<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ffffff">
<meta name="description" content="Shopper's Suggestions launches April 2027.">
<title>Shopper’s Suggestions — Coming Soon</title>
<style>
:root{color-scheme:light;--bg:#fff;--text:#111827;--muted:#667085;--line:#e5e7eb;--accent:#e87524;--soft:#fff2e8}
[data-theme=dark]{color-scheme:dark;--bg:#101318;--text:#f4f6f8;--muted:#a3adba;--line:#2b323d;--accent:#ff9a52;--soft:#302218}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;transition:.2s}
.page{width:min(1100px,calc(100% - 40px));min-height:100vh;margin:auto;display:flex;flex-direction:column}
header,footer{display:flex;align-items:center;justify-content:space-between;gap:18px;border-color:var(--line)}
header{min-height:88px;border-bottom:1px solid var(--line)}.brand{font-weight:800;font-size:17px;letter-spacing:-.5px}.brand span,h1 span{color:var(--accent)}
.theme{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:13px;font-weight:600}
select{border:1px solid var(--line);border-radius:30px;padding:9px 13px;background:var(--bg);color:var(--text);font:inherit}
main{flex:1;display:grid;place-items:center;text-align:center;padding:80px 0}
.content{width:min(100%,760px)}.eyebrow{display:inline-block;padding:9px 14px;border-radius:30px;background:var(--soft);color:var(--accent);font-size:11px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase}
h1{margin:28px 0 18px;font-size:clamp(46px,9vw,88px);line-height:1;letter-spacing:-.075em;font-weight:850}
.label{margin:0;color:var(--muted);font-size:12px;font-weight:750;letter-spacing:2.5px;text-transform:uppercase}
.date{margin:12px 0 0;font-size:clamp(26px,5vw,38px);font-weight:750;letter-spacing:-1px}
.desc{max-width:560px;margin:25px auto 0;color:var(--muted);font-size:16px;line-height:1.8}
.rule{width:54px;height:3px;margin:38px auto 0;border-radius:8px;background:var(--accent)}
footer{min-height:82px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}
.about{padding:0;border:0;background:none;color:var(--text);font:inherit;text-decoration:underline;text-decoration-color:var(--accent);text-underline-offset:4px;cursor:pointer}
.about:hover,.close:hover{color:var(--accent)}
dialog{width:min(calc(100% - 32px),480px);padding:30px;border:1px solid var(--line);border-radius:20px;background:var(--bg);color:var(--text)}
dialog::backdrop{background:#0008;backdrop-filter:blur(3px)}dialog h2{margin:0 0 12px}dialog p{color:var(--muted);line-height:1.7}
.close{margin-top:20px;padding:0;border:0;background:none;color:var(--accent);font:inherit;font-weight:700;cursor:pointer}
@media(max-width:600px){.page{width:calc(100% - 32px)}header{min-height:76px}.brand{font-size:14px}.theme{font-size:12px;gap:6px}main{padding:65px 0}.desc{font-size:14px}footer{padding:22px 0;flex-direction:column;justify-content:center;text-align:center}}
</style>
<script type="text/javascript" nonce="1b37d3c38be74c6ab4e6f33f9a1" src="//local.adguard.org?ts=1793427413848&amp;type=content-script&amp;dmn=chatgpt.com&amp;url=https%3A%2F%2Fchatgpt.com%2Fbackend-api%2Festuary%2Fcontent%3Fid%3Dfile_000000007a188211a8bdbc8d4a7a2d03%26fn%3Dshoppers-suggestions-coming-soon.html%26cd%3Dattachment%26ts%3D498174%26p%3Dfs%26cid%3D1%26sig%3Dbf922825e18e2cf2a5a095c169f21e24a3d2acb15f1d4a2f904aad3dd8d56ca9%26v%3D0&amp;app=chrome.exe&amp;css=2&amp;js=1&amp;rel=1&amp;rji=1&amp;sbe=1"></script><script type="text/javascript" nonce="1b37d3c38be74c6ab4e6f33f9a1" src="//local.adguard.org?ts=1793427413848&amp;name=AdGuard%20Extra&amp;name=AdGuard%20Popup%20Blocker&amp;type=user-script"></script></head>
<body>
<div class="page">
<header><div class="brand">Shopper’s <span>Suggestions</span></div><label class="theme" for="themeSelect">Theme <select id="themeSelect" aria-label="Choose theme"><option value="light">White</option><option value="dark">Dark</option></select></label></header>
<main><section class="content"><div class="eyebrow">A new experience is on its way</div><h1>COMING <span>SOON</span></h1><p class="label">Official launch</p><p class="date">April 2027</p><p class="desc">We’re working behind the scenes to bring you something special. A new way to discover products and shopping suggestions is coming soon.</p><div class="rule" aria-hidden="true"></div></section></main>
<footer><span>© 2027 Shopper’s Suggestions. All rights reserved.</span><button class="about" id="aboutOpen" type="button">About Shopper’s Suggestions</button></footer>
</div>
<dialog id="aboutDialog"><h2>About Shopper’s Suggestions</h2><p>Shopper’s Suggestions is being built to help people discover useful products and explore shopping suggestions in one place. We’re preparing the experience for our planned launch in April 2027.</p><button class="close" id="aboutClose" type="button">Close</button></dialog>
<script>
(()=>{const root=document.documentElement,select=document.getElementById('themeSelect'),dialog=document.getElementById('aboutDialog');function theme(v){v=v==='dark'?'dark':'light';root.dataset.theme=v;select.value=v;document.querySelector('meta[name="theme-color"]').content=v==='dark'?'#101318':'#ffffff'}let saved='light';try{saved=localStorage.getItem('shopperSuggestionsTheme')||'light'}catch(e){}theme(saved);select.addEventListener('change',()=>{theme(select.value);try{localStorage.setItem('shopperSuggestionsTheme',select.value)}catch(e){}});document.getElementById('aboutOpen').addEventListener('click',()=>dialog.showModal());document.getElementById('aboutClose').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()})})();
</script>
</body>
</html>
